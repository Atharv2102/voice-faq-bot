digraph VoiceFAQBot {
  rankdir=TB;
  bgcolor="#ffffff";
  splines=true;
  nodesep=0.4;
  ranksep=0.6;

  node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=8.5, color="#555555"];

  // ─────── Users ───────
  subgraph cluster_users {
    label="Users";
    style="rounded,filled"; fillcolor="#f3f6fb"; color="#aab8cc";
    fontname="Helvetica-Bold"; fontsize=11;

    teamsUser   [label="Teams user\n(text + voice)", fillcolor="#3a5ab0", fontcolor=white];
    adminUser   [label="Admin user\n(browser)", fillcolor="#3a5ab0", fontcolor=white];
  }

  // ─────── Azure ───────
  azureBot [label="Azure Bot Service\n(single-tenant, F0)\nCLIENT_ID / SECRET / TENANT_ID",
            fillcolor="#0078d4", fontcolor=white];

  // ─────── teams-bot (Render) ───────
  subgraph cluster_bot {
    label="teams-bot   (Render web service)";
    style="rounded,filled"; fillcolor="#f6f0fc"; color="#a075cc";
    fontname="Helvetica-Bold"; fontsize=11;

    botMsg     [label="POST /api/messages\napp.on('message')", fillcolor="#ffffff"];
    botProact  [label="POST /api/proactive\n(secret-protected)", fillcolor="#ffffff"];
    botTranscr [label="voice → confirm UX\nuser says yes / no / correction", fillcolor="#fffbf4", shape=note];
  }

  whisper [label="OpenAI Whisper\n(audio → text)", fillcolor="#10a37f", fontcolor=white];

  // ─────── Backend (Render) ───────
  subgraph cluster_backend {
    label="backend   (Render web service · Express)";
    style="rounded,filled"; fillcolor="#fff6e8"; color="#cc9a55";
    fontname="Helvetica-Bold"; fontsize=11;

    // Routes
    subgraph cluster_routes {
      label="Routes"; style="rounded,filled"; fillcolor="#fffaee"; color="#e7d2ad";
      fontname="Helvetica"; fontsize=10;

      rQuery    [label="/api/query", fillcolor="#ffffff"];
      rCmd      [label="/api/admin-command\n/api/admin-confirm", fillcolor="#ffffff"];
      rSugg     [label="/api/suggestions\n(public + JWT)", fillcolor="#ffffff"];
      rAuth     [label="/api/auth/login\n/api/auth/register\n/api/auth/link-code\n/api/auth/link-claim\n/api/auth/me", fillcolor="#ffffff"];
      rPanel    [label="/api/questions\n/api/audit-log\n/api/query-log\n/api/lock/:id\n/api/import", fillcolor="#ffffff"];
      rInternal [label="/api/bot/notify\n/api/conv-ref/:id\n(internal)", fillcolor="#fff3d6"];
    }

    // Services
    subgraph cluster_services {
      label="Services"; style="rounded,filled"; fillcolor="#fffaee"; color="#e7d2ad";
      fontname="Helvetica"; fontsize=10;

      svcIntent   [label="intent.js\n(regex parser)", fillcolor="#ffffff"];
      svcNlp      [label="nlpIntent.js\n(Claude fallback)", fillcolor="#ffffff"];
      svcCmd      [label="commandHandler.js\n(dispatcher)", fillcolor="#ffffff"];
      svcSem      [label="semanticMatcher.js\n(Fuse + Claude rerank)", fillcolor="#ffffff"];
      svcPending  [label="pendingActions.js\n(yes/no confirm)", fillcolor="#ffffff"];
      svcLock     [label="lockManager.js\n(edit locks)", fillcolor="#ffffff"];
      svcLink     [label="linkCodes.js\n(6-digit codes)", fillcolor="#ffffff"];
      svcEmail    [label="emailNotifier.js\n(Nodemailer)", fillcolor="#ffffff"];
      svcStore    [label="fileStore.js\n(JSON mutex)", fillcolor="#ffffff"];
      svcExcel    [label="excelLogger.js\n(xlsx writes)", fillcolor="#ffffff"];
      svcConv     [label="conversationStore.js", fillcolor="#ffffff"];
    }

    // Data
    subgraph cluster_data {
      label="backend/data/  (committed seed + runtime writes)";
      style="rounded,filled"; fillcolor="#fff3d6"; color="#cc9a55";
      fontname="Helvetica"; fontsize=10;

      dFaqs   [label="faqs.json",            fillcolor="#ffffff", fontsize=9];
      dAdm    [label="admins.json",          fillcolor="#ffffff", fontsize=9];
      dSug    [label="suggestions.json",     fillcolor="#ffffff", fontsize=9];
      dConv   [label="conversation-refs.json", fillcolor="#ffffff", fontsize=9];
      dAud    [label="audit-log.xlsx",       fillcolor="#ffffff", fontsize=9];
      dQLog   [label="query-log.xlsx",       fillcolor="#ffffff", fontsize=9];
    }
  }

  claude [label="Anthropic Claude\n(haiku, prompt-cached)\nintent + FAQ rerank", fillcolor="#cc785c", fontcolor=white];
  smtp   [label="SMTP\n(Gmail / O365)", fillcolor="#dddddd"];

  // ─────── Admin panel ───────
  adminPanel [label="admin-panel\n(Render static site · React + Vite)\n\n/login   /register   /dashboard\n/questions   /suggestions   /import\n/audit   /queries   /profile (link Teams)",
              fillcolor="#e9f7ee", color="#3a9d6a"];

  // ─────── Edges ───────

  // user → bot path
  teamsUser  -> azureBot      [label="HTTPS"];
  azureBot   -> botMsg;
  botMsg     -> whisper       [label="audio", style=dashed];
  whisper    -> botMsg        [label="text", style=dashed];
  botMsg     -> botTranscr    [label="if voice", style=dotted];

  // bot → backend
  botMsg     -> rCmd          [label="all messages"];
  botMsg     -> rQuery        [label="fallback if\nnot a command"];

  // backend → claude
  svcNlp     -> claude        [style=dashed];
  svcSem     -> claude        [style=dashed];

  // commandHandler wiring
  rCmd       -> svcCmd;
  svcCmd     -> svcIntent;
  svcCmd     -> svcNlp        [label="if no\nregex match"];
  svcCmd     -> svcPending;
  rQuery     -> svcSem;

  // panel ↔ backend
  adminUser  -> adminPanel    [label="HTTPS"];
  adminPanel -> rAuth         [label="login / register /\nlink-code / me"];
  adminPanel -> rPanel        [label="CRUD + lock\n+ import + logs"];
  adminPanel -> rSugg         [label="approve / reject"];

  // proactive loop
  rSugg      -> rInternal     [label="approve/reject\n→ notify user", style=dashed];
  rInternal  -> botProact     [label="POST /api/proactive"];
  botProact  -> azureBot      [label="Bot Connector\nREST API"];
  azureBot   -> teamsUser     [label="proactive DM", style=dashed];

  // link codes flow
  rAuth      -> svcLink;
  svcCmd     -> svcLink       [label="link <code>\nclaims"];

  // writes
  svcPending -> svcStore;
  svcCmd     -> svcStore;
  svcCmd     -> svcExcel;
  svcCmd     -> svcEmail;
  svcEmail   -> smtp          [style=dashed];

  svcStore   -> dFaqs;
  svcStore   -> dAdm;
  svcStore   -> dSug;
  svcConv    -> dConv;
  svcExcel   -> dAud;
  svcExcel   -> dQLog;
  rInternal  -> svcConv;
  botMsg     -> rInternal     [label="POST conv-ref\n(stored)", style=dotted];

  rAuth      -> svcStore      [label="register +\nlogin", style=dotted];
}
