JWT_SECRET=replace-me-with-random-string
PORT=3000
ADMIN_PANEL_URL=http://localhost:5173
BOT_URL=http://localhost:3978
BOT_PROACTIVE_SECRET=replace-me

# Optional — enables natural-language intent fallback for informal commands.
# Without it, only the explicit "add question X answer Y" forms are recognised.
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5

# Self-registration controls (both optional, can be combined)
# If set, registrations must include this code in the form
REGISTER_CODE=
# If set, only emails ending in these domains may register (comma-separated)
ALLOWED_EMAIL_DOMAINS=

# Access control
# If true, anyone on Teams can query the bot (skips the users.json allowlist).
# LT and admin still require entries in admins.json.
ACCESS_OPEN_MODE=false

# Time window (in hours) during which a recent change can be reverted via the
# `revert last change` or `revert the answer for <topic>` voice commands.
# Default 168 hours (7 days). Set to 0 to disable revert entirely.
REVERT_WINDOW_HOURS=168

# ── Email transport ─────────────────────────────────────────────────────────
# Mode is auto-selected:
#   1. Microsoft Graph (service account) — preferred for M365 orgs
#   2. SMTP — fallback
#   3. Console — neither configured; emails are logged
#
# (1) Microsoft Graph — requires an Azure AD app registration with
#     `Mail.Send` Application permission + admin consent. The sender mailbox
#     must exist in the tenant and the app must be permitted to send-as it
#     (optionally scoped via New-ApplicationAccessPolicy in Exchange Online).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=

# (2) SMTP — used only if Graph is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FAQ Bot <noreply@example.com>"
