JWT_SECRET=replace-me-with-random-string
PORT=3000
ADMIN_PANEL_URL=http://localhost:5173
BOT_URL=http://localhost:3978
BOT_PROACTIVE_SECRET=replace-me

# Optional — enables natural-language intent fallback for informal commands.
# Without it, only the explicit "add question X answer Y" forms are recognised.
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5

# Self-registration controls (both optional, can be combined)
# If set, registrations must include this code in the form
REGISTER_CODE=
# If set, only emails ending in these domains may register (comma-separated)
ALLOWED_EMAIL_DOMAINS=

# SMTP config — leave blank in dev to log emails to console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FAQ Bot <noreply@example.com>"
