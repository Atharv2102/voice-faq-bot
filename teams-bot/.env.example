# Azure Bot registration (single-tenant)
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

BACKEND_URL=http://localhost:3000
OPENAI_API_KEY=
PORT=3978
BOT_PROACTIVE_SECRET=replace-me

# Set to "production" on Render — disables DevtoolsPlugin
NODE_ENV=

# Used only by `npm run package-manifest` — the public HTTPS domain of the deployed bot
BOT_DOMAIN=
